#!/bin/sh

ROOT="$(dirname "$(readlink -f "$0")")"
readonly ROOT

bail() {
  [ $# -gt 0 ] && printf "$@" >&2
  exit 1;
}
usage() {
  printf 'Usage: %s command...\nAvailable Commands:\n' "$0" >&2
  sed -ne 's/^\([a-z_]\+\)() (/\1/p' "$0" >&2
  exit 1
}
[ $# -gt 0 ] || usage

# Typically initial setup, or system upgrade, but requires apt-based system
# and so is not included in "all".
apt() (
  sudo apt-get install -y curl ||bail
)

lix() (
  curl -sSf -L https://install.lix.systems/lix | sh -s -- install ||bail
)

# quality-of-life hacks for darwin/home
nix_qol() (
  mkdir -p ~/.config ||bail
  # we are only impure for this single "local" config file, maybe revisit a
  # hosts-based approach, but seems unecessary
  [ -e ~/.config/home.nix ] || cp "$ROOT/nix/template.nix" ~/.config/home.nix ||bail
  # not realizing an unstaged change is being ignored is infuriating
  git -C "$ROOT" add -A
)

darwin() (
  nix_qol ||bail
  [ -e /etc/nix-darwin ] || sudo ln -s "$ROOT/nix" /etc/nix-darwin ||bail
  sudo nix --experimental-features 'flakes nix-command' run 'nix-darwin/nix-darwin-25.11#darwin-rebuild' -- switch --impure ||bail
)

home() (
  nix_qol ||bail
  nix --experimental-features 'flakes nix-command' run 'nixpkgs#home-manager' -- switch --impure --flake "$ROOT/nix#$USER" --show-trace ||bail
)

etc() (
  mkdir -p ~/.config ||bail
  cd "$ROOT"/etc ||bail
  for name in *; do
    if [ "$name" = config ]; then
      continue
    fi
    if [ -d "$name" ]; then
      ln -sf "$ROOT"/etc/"$name" ~/.config ||bail
    else
      ln -sf "$ROOT"/etc/"$name" ~/."$name" ||bail
    fi
  done
  cd "$ROOT"/etc/config ||bail
  for name in *; do
      ln -sf "$ROOT"/etc/config/"$name" ~/.config ||bail
  done
)

bin() (
  mkdir -p ~/.local/bin ||bail
  cd "$ROOT"/bin ||bail
  for name in *; do
    ln -sf "$ROOT"/bin/"$name" ~/.local/bin/"$name" ||bail
  done
)

bash_preexec() (
  curl -sSL https://github.com/rcaloras/bash-preexec/archive/refs/tags/0.6.0.tar.gz \
    | tar -C ~ -xzf - --strip-components=1 bash-preexec-0.6.0/bash-preexec.sh || bail
  mv ~/bash-preexec.sh ~/.bash-preexec.sh ||bail
)

core() (
  etc ||bail
  bin ||bail
  bash_preexec ||bail
)

bob() (
  "$(which bob)" use 0.11.5 >/dev/null || bail
)

for cmd in "$@"; do
  if ! type "$cmd" | grep -q "function"; then
    printf 'Error: Unknown command `%s`\n\n' "$cmd" >&2
    usage
  fi
done

for cmd in "$@"; do
  "$cmd" ||bail "failed during %s\n" "$cmd"
done
